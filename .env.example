# Required
CRISP_IDENTIFIER=your_crisp_identifier
CRISP_KEY=your_crisp_key

# Optional Crisp settings
CRISP_BASE_URL=https://api.crisp.chat/v1
# If set, webhook signature is enforced (recommended for plugin hooks)
CRISP_HOOK_SECRET=your_plugin_hook_secret
CRISP_HOOK_MAX_SKEW_SECONDS=300

# Optional hard allow-list (comma separated website IDs)
CRISP_ALLOWED_WEBSITE_IDS=40846966-0f0d-45f6-b72b-8a24bf268953

# Server
HOST=0.0.0.0
PORT=8080
WEBHOOK_PATH=/crisp/webhook
HEALTH_PATH=/healthz
LOG_LEVEL=INFO

# Note template / dedupe
AUTO_NOTE_MARKER=[AUTO_TRADEIN_NOTE]
AUTO_NOTE_TEMPLATE=trade-in-id: {trade_in_id} | item-id: {item_id} | backoffice: {backoffice_link}

# Persistence
SQLITE_PATH=./auto_tradein_note.db
